#include<stdio.h>
#include<stdlib.h>
#include<string.h>

char* smallestPalindrome(char* s)
{
    int freq[26] = {0};
    int n = strlen(s);
    for(int i=0;i<n;i++)
    {
        freq[s[i]- 'a']++;
    }
    char *ans = (char *)malloc(n+1);
    int left=0;
    int right = n-1;

    for(int i=0;i<26;i++)
    {
        while(freq[i] >=2)
        {
            ans[left++] = 'a' + i;
            ans[right--] = 'a' + i;
            freq[i] -=2;
        }
    }
    for(int i=0;i<26;i++)
    {
        if(freq[i]==1)
        {
            ans[left] = 'a' + i;
            break;
        }
    }
    ans[n] ='\0';
    return ans;
}
