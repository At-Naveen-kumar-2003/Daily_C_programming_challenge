#include <stdio.h>
#include <stdint.h>

#define SET_BIT(reg,bit)  ((reg) |= (1<<(bit)))
#define CLEAR_BIT(reg,bit)  ((reg) &= ~(1<<(bit)))
#define TOGGLE_BIT(reg,bit)  ((reg) ^= (1<<(bit)))

uint8_t modify_register(uint8_t reg) {
    SET_BIT(reg,2);
    SET_BIT(reg,7);
    CLEAR_BIT(reg,3);
    TOGGLE_BIT(reg,5);
    return reg;
}

int main() {
    uint8_t reg;
    scanf("%hhu", &reg);
    printf("%u", modify_register(reg));
    return 0;
}
