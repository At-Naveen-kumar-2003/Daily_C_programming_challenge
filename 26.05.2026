int numberOfSpecialChars(char* word) {
    
    int lower = 0;
    int upper = 0;

    for(int i = 0; word[i] != '\0'; i++) {

        if(word[i] >= 'a' && word[i] <= 'z') {
            lower |= (1 << (word[i] - 'a'));
        }
        else if(word[i] >= 'A' && word[i] <= 'Z') {
            upper |= (1 << (word[i] - 'A'));
        }
    }

    int common = lower & upper;

    int count = 0;

    while(common) {
        count += (common & 1);
        common >>= 1;
    }

    return count;
}
